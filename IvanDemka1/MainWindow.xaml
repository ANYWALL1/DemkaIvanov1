<Window x:Class="IvanDemka1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beauty Salon - Главная" Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Panel -->
        <Grid Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Image Source="Resources/beauty_logo.png" Width="60" Height="60" Margin="10"/>
            
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="tbSearch" Width="150" TextChanged="tbSearch_TextChanged"/>
                
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="cbSort" Width="150" SelectionChanged="FilterAndSortData">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="По возрастанию цены"/>
                    <ComboBoxItem Content="По убыванию цены"/>
                </ComboBox>

                <TextBlock Text="Скидка:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="cbFilter" Width="120" SelectionChanged="FilterAndSortData">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="от 0 до 5%"/>
                    <ComboBoxItem Content="от 5% до 15%"/>
                    <ComboBoxItem Content="от 15% до 30%"/>
                    <ComboBoxItem Content="от 30% до 70%"/>
                    <ComboBoxItem Content="от 70% до 100%"/>
                </ComboBox>
            </WrapPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <TextBox x:Name="tbAdminCode" Width="60" Margin="5" />
                <Button Content="Вход" Click="btnAdmin_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ListView x:Name="lvServices" Grid.Row="1" Margin="10" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Background="{Binding BackgroundColor}">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Margin="5"/>

                            <StackPanel Grid.Column="1" Margin="10,5">
                                <TextBlock Text="{Binding Title}" FontSize="16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding StrikethroughPrice}" TextDecorations="Strikethrough" 
                                               Visibility="{Binding StrikethroughVisibility}" />
                                    <TextBlock Text="{Binding PriceDurationText}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DiscountText}" Foreground="Gray" Margin="0,0,0,5"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5" Visibility="{Binding AdminVisibility}">
                                    <Button Content="редактировать" Click="btnEditItem_Click" Margin="0,0,5,0" Padding="10,2" Background="White" BorderBrush="Gray" Foreground="Black"/>
                                    <Button Content="удалить" Click="btnDeleteItem_Click" Padding="10,2" Background="White" BorderBrush="Gray" Foreground="Black"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom Panel -->
        <Grid Grid.Row="2" Background="{StaticResource SecondaryBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <WrapPanel x:Name="pnlAdminControls" Visibility="Collapsed" VerticalAlignment="Center" Margin="10">
                <Button Content="Добавить" Click="btnAdd_Click"/>
                <Button Content="Записать" Click="btnAppointment_Click"/>
                <Button Content="Ближайшие" Click="btnUpcoming_Click"/>
            </WrapPanel>
            
            <TextBlock x:Name="tbCounter" Grid.Column="1" Text="0 из 0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10"/>
        </Grid>
    </Grid>
</Window>
